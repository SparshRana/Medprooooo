# Optional account services. Local pack checking and review notes work without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server/worker only. Never use NEXT_PUBLIC_ for private keys.
SUPABASE_SERVICE_ROLE_KEY=
OPENMRP_API_KEY=
MEDPRO_MONITORING_ENABLED=false
MEDPRO_ALERT_FROM=
RESEND_API_KEY=
MEDPRO_ALERT_SNAPSHOT=data/cdsco-alerts.json
# Signed offline update packages (base64 raw Ed25519 public key; private PEM is worker-only).
NEXT_PUBLIC_ALERT_SIGNING_KEY=
MEDPRO_ALERT_SIGNING_PRIVATE_KEY=
